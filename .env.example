# ==============================================================================
# ENVIRONMENT VARIABLES — SISTEM PEMANTAUAN SUHU RS FATMAWATI
# ==============================================================================

# Supabase Credentials (server-side only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# API Security Secret (untuk autentikasi sensor ESP8266 & cron)
API_SECRET=your-secret-api-key

# Integrasi Notifikasi Telegram
# Dapatkan dari @BotFather:
TELEGRAM_BOT_TOKEN=
# Dapatkan username publik Channel (misal: @server_fatmawati) atau ID numerik (-100xxxxxxxxx):
TELEGRAM_CHAT_ID=

# Website Domain URL
NEXT_PUBLIC_SITE_URL=https://nextjs-app-ten-blue.vercel.app
